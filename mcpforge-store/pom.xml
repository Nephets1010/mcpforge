<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.nephets</groupId>
    <artifactId>mcpforge</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>mcpforge-store</artifactId>
  <name>mcpforge-store</name>
  <description>MCP 工具存储层：ToolRegistry 作为工具元数据与处理器的内存存储（注册表），提供注册、查重、容量上限与并发安全访问。依赖 contract 层，无 Spring 依赖。</description>

  <!--
    ★ store 层是「契约 + 存储实现」的拆分产物：ToolRegistry 原位于 core，现独立成存储模块，
      被 core 的 McpDispatcher 与 starter 的自动装配共同依赖。所有类型仍放在
      io.github.nephets.mcpforge.core 包下，全限定类名不变。store 严禁引入 org.springframework.*。
  -->
  <dependencies>
    <dependency>
      <groupId>io.github.nephets</groupId>
      <artifactId>mcpforge-contract</artifactId>
    </dependency>

    <!-- 存储层的可观测性日志门面（版本由 Spring Boot 父 POM 管理）。严禁引入任何 org.springframework.*。 -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/package-info.java</exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <properties>
    <jacoco.line.minimum>0.60</jacoco.line.minimum>
    <jacoco.report.skip>false</jacoco.report.skip>
  </properties>
</project>
